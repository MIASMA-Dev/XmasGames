{
  "name": "navidad-juegos-multiequipo",
  "version": "1.0.0",
  "description": "Juegos navideños multiequipo con sensores del móvil en red local",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "ng build --configuration production",
