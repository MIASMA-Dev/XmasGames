    "minVersion": { "ios": 13, "android": 8 }
  },
  
  "feedback": {
    "visual": true,
    "sound": true,
    "haptic": false
  },
  
  "scoring": {
    "camera": {
      "trigger": "capture",
      "points": 5,
      "cooldown": 1500
    }
  }
